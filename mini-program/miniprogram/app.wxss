/* KaTeX 公式渲染样式（katex-mini 本地打包版，无需“构建 npm”） */
@import "./lib/katex.wxss";

/**
 * 全局样式 - 全国大学生数学竞赛真题库
 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background: #F5F5F5;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.page-header {
  background: linear-gradient(135deg, #07C160, #06AE56);
  color: #fff;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.badge-primary { background: #E6F7FF; color: #1677FF; }
.badge-success { background: #E8F8E8; color: #07C160; }
.badge-warm { background: #FFF7E6; color: #FA8C16; }

.btn-primary {
  background: #07C160;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.search-box input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.empty-state .icon { font-size: 96rpx; margin-bottom: 24rpx; }