<view class="page">
  <view class="search-header">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" value="{{query}}" bindinput="onInput" bindconfirm="onSearch"
             placeholder="搜索题目、知识点、年份…" focus />
      <text class="search-clear" wx:if="{{query}}" bindtap="onClear">×</text>
    </view>
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <view class="container">
    <view class="result-list" wx:if="{{results.length > 0}}">
      <text class="result-count">找到 {{results.length}} 条结果</text>
      <view class="result-card" wx:for="{{results}}" wx:key="id"
            data-id="{{item.id}}" data-paperId="{{item.paper_id}}" bindtap="goToQuestion">
        <view class="result-head">
          <text class="result-no">{{item.question_no}}</text>
          <text class="result-type">{{item.question_type}}</text>
          <text class="result-score">{{item.score}}分</text>
        </view>
        <text class="result-stem">{{item.stem_preview}}</text>
        <text class="result-paper">📄 {{item.paper_title}}</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{query && !searching && results.length === 0}}">
      <text class="empty-icon">🔍</text>
      <text>没有找到相关题目</text>
    </view>
    <view class="empty-state" wx:if="{{!query}}">
      <text class="empty-icon">📝</text>
      <text>输入关键词开始搜索</text>
    </view>
  </view>
</view>