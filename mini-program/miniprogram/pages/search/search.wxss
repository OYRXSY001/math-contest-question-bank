.page { background: #F5F5F5; min-height: 100vh; }
.search-header { background: #fff; padding: 16rpx 24rpx; display: flex; align-items: center; gap: 12rpx; border-bottom: 1rpx solid #eee; }
.search-input-wrap { flex: 1; display: flex; align-items: center; background: #F5F5F5; border-radius: 40rpx; padding: 0 24rpx; }
.search-icon { font-size: 24rpx; }
.search-input { flex: 1; height: 64rpx; font-size: 26rpx; }
.search-clear { font-size: 28rpx; color: #999; padding: 0 8rpx; }
.search-btn { background: #07C160; color: #fff; padding: 12rpx 28rpx; border-radius: 40rpx; font-size: 26rpx; }
.container { padding: 20rpx; }
.result-count { font-size: 24rpx; color: #999; margin-bottom: 12rpx; display: block; }
.result-card { background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.04); }
.result-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.result-no { font-size: 28rpx; font-weight: 700; color: #07C160; }
.result-type { font-size: 20rpx; background: #FFF7E6; color: #FA8C16; padding: 2rpx 10rpx; border-radius: 8rpx; }
.result-score { font-size: 22rpx; color: #999; }
.result-stem { font-size: 24rpx; color: #333; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.result-paper { font-size: 22rpx; color: #1677FF; margin-top: 8rpx; }
.empty-state { text-align: center; padding: 80rpx 0; color: #999; }
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }