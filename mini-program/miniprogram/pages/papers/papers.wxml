<view class="page">
  <view class="filter-bar">
    <scroll-view scroll-x class="filter-scroll">
      <view class="filter-group">
        <text class="filter-label">年份</text>
        <view class="filter-chip {{filters.year === item ? 'active' : ''}}"
              wx:for="{{years}}" wx:key="*this"
              data-val="{{item}}" bindtap="onYearFilter">{{item}}</view>
      </view>
      <view class="filter-group">
        <text class="filter-label">轮次</text>
        <view class="filter-chip {{filters.round === item ? 'active' : ''}}"
              wx:for="{{rounds}}" wx:key="*this"
              data-val="{{item}}" bindtap="onRoundFilter">{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="container">
    <view class="search-mini" bindtap="onSearch">
      <text class="search-icon">🔍</text>
      <text class="search-text">搜索题目或知识点…</text>
    </view>

    <view class="paper-list">
      <view class="paper-card" wx:for="{{papers}}" wx:key="id" data-id="{{item.id}}" bindtap="goToPaper">
        <view class="paper-main">
          <text class="paper-year">{{item.year}}</text>
          <view class="paper-info">
            <text class="paper-title">{{item.title}}</text>
            <view class="paper-tags">
              <text class="tag">{{item.round}}</text>
              <text class="tag">{{item.question_count}}题</text>
            </view>
          </view>
        </view>
        <text class="paper-arrow">›</text>
      </view>
      <view class="empty-state" wx:if="{{papers.length === 0 && !loading}}">
        <text class="empty-icon">📚</text>
        <text>暂无真题</text>
      </view>
    </view>
  </view>
</view>