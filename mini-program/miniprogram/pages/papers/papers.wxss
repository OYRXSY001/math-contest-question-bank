.page { background: #F5F5F5; min-height: 100vh; }
.filter-bar { background: #fff; padding: 16rpx 0; border-bottom: 1rpx solid #eee; }
.filter-scroll { white-space: nowrap; }
.filter-group { display: inline-flex; align-items: center; padding: 8rpx 24rpx; gap: 12rpx; }
.filter-label { font-size: 24rpx; color: #999; }
.filter-chip { font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 20rpx; background: #F0F0F0; color: #666; display: inline-block; }
.filter-chip.active { background: #07C160; color: #fff; }
.container { padding: 20rpx; }
.search-mini { display: flex; align-items: center; background: #fff; border-radius: 40rpx; padding: 12rpx 24rpx; margin-bottom: 20rpx; }
.search-icon { font-size: 24rpx; }
.search-text { font-size: 26rpx; color: #999; margin-left: 12rpx; }
.paper-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.paper-main { display: flex; gap: 16rpx; flex: 1; }
.paper-year { font-size: 28rpx; font-weight: 700; color: #1677FF; min-width: 96rpx; }
.paper-info { flex: 1; }
.paper-title { font-size: 26rpx; color: #333; display: block; margin-bottom: 6rpx; }
.paper-tags { display: flex; gap: 8rpx; }
.tag { font-size: 20rpx; background: #F0F0F0; color: #666; padding: 2rpx 10rpx; border-radius: 8rpx; }
.paper-arrow { font-size: 40rpx; color: #ccc; }
.empty-state { text-align: center; padding: 60rpx 0; color: #999; }
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }