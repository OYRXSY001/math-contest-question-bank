<view class="page">
  <view class="paper-header card" wx:if="{{paper}}">
    <text class="paper-year">{{paper.year}}</text>
    <view class="paper-info">
      <text class="paper-title">{{paper.title}}</text>
      <view class="paper-meta">
        <text class="tag">{{paper.round}}</text>
        <text class="meta-text">{{questions.length}}题</text>
        <text class="meta-text">{{paper.total_score}}分</text>
      </view>
    </view>
  </view>

  <view class="container">
    <view class="kp-section" wx:if="{{knowledgePoints.length}}">
      <text class="section-title">涉及知识点</text>
      <view class="kp-tags">
        <text class="kp-tag" wx:for="{{knowledgePoints}}" wx:key="id"
              data-q="{{item.name}}" bindtap="goToSearch">{{item.name}}</text>
      </view>
    </view>

    <text class="section-title">题目列表</text>
    <view class="q-list">
      <view class="q-card" wx:for="{{questions}}" wx:key="id"
            data-id="{{item.id}}" data-paperId="{{paper ? paper.id : 0}}" bindtap="goToQuestion">
        <view class="q-head">
          <text class="q-no">{{item.question_no}}</text>
          <text class="q-type">{{item.question_type}}</text>
          <text class="q-score">{{item.score}}分</text>
        </view>
        <text class="q-stem">{{item.stem_preview}}</text>
      </view>
      <view class="empty-state" wx:if="{{questions.length === 0}}">
        <text>暂无题目</text>
      </view>
    </view>
  </view>
</view>