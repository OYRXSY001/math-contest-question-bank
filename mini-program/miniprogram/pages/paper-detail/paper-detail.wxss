.page { background: #F5F5F5; min-height: 100vh; }
.card { background: #fff; border-radius: 0; padding: 0; margin: 0; box-shadow: none; }
.paper-header { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx; border-bottom: 1rpx solid #eee; }
.paper-year { font-size: 32rpx; font-weight: 700; color: #1677FF; min-width: 120rpx; }
.paper-info { flex: 1; }
.paper-title { font-size: 26rpx; color: #333; display: block; margin-bottom: 8rpx; }
.paper-meta { display: flex; align-items: center; gap: 12rpx; }
.tag { font-size: 20rpx; background: #E8F8E8; color: #07C160; padding: 2rpx 12rpx; border-radius: 10rpx; }
.meta-text { font-size: 22rpx; color: #999; }
.container { padding: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; color: #333; display: block; }
.kp-section { margin-bottom: 24rpx; }
.kp-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.kp-tag { font-size: 22rpx; background: #E6F7FF; color: #1677FF; padding: 6rpx 16rpx; border-radius: 20rpx; }
.q-card { background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.04); }
.q-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.q-no { font-size: 28rpx; font-weight: 700; color: #07C160; }
.q-type { font-size: 20rpx; background: #FFF7E6; color: #FA8C16; padding: 2rpx 10rpx; border-radius: 8rpx; }
.q-score { font-size: 22rpx; color: #999; margin-left: auto; }
.q-stem { font-size: 24rpx; color: #333; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.empty-state { text-align: center; padding: 40rpx 0; color: #999; }