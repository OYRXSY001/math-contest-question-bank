.page { background: #F5F5F5; min-height: 100vh; }
.me-header { background: linear-gradient(135deg, #07C160, #06AE56); color: #fff; padding: 48rpx 32rpx; display: flex; align-items: center; gap: 24rpx; }
.avatar-circle { width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.user-info { flex: 1; }
.user-nick { font-size: 32rpx; font-weight: 600; display: block; }
.user-id { font-size: 22rpx; opacity: .7; margin-top: 4rpx; display: block; word-break: break-all; }
.stats-row { display: flex; background: #fff; margin: -32rpx 24rpx 0; border-radius: 12rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.08); position: relative; z-index: 1; }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 36rpx; font-weight: 700; color: #07C160; display: block; }
.stat-label { font-size: 22rpx; color: #999; }
.me-tabs { display: flex; background: #fff; margin: 16rpx 0; }
.me-tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; color: #666; border-bottom: 3rpx solid transparent; }
.me-tab.active { color: #07C160; border-bottom-color: #07C160; font-weight: 600; }
.container { padding: 0 24rpx; }
.me-card { background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.04); }
.me-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.me-no { font-size: 26rpx; font-weight: 700; color: #07C160; }
.me-type { font-size: 20rpx; background: #FFF7E6; color: #FA8C16; padding: 2rpx 10rpx; border-radius: 8rpx; }
.me-stem { font-size: 24rpx; color: #333; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.me-paper { font-size: 22rpx; color: #1677FF; margin-top: 8rpx; }
.empty-state { text-align: center; padding: 60rpx 0; color: #999; }
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.empty-btn { margin-top: 24rpx; display: inline-block; background: #07C160; color: #fff; padding: 12rpx 36rpx; border-radius: 40rpx; font-size: 24rpx; }