<view class="page">
  <view class="me-header">
    <view class="avatar-circle">👤</view>
    <view class="user-info">
      <text class="user-nick">{{openid ? '同学你好' : '未登录'}}</text>
      <text class="user-id">{{openid ? openid : ''}}</text>
    </view>
  </view>

  <view class="stats-row">
    <view class="stat-item">
      <text class="stat-num">{{stats.favoriteCount}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.wrongCount}}</text>
      <text class="stat-label">错题</text>
    </view>
  </view>

  <view class="me-tabs">
    <view class="me-tab {{tab === 'favorite' ? 'active' : ''}}" data-tab="favorite" bindtap="switchTab">
      <text>⭐ 收藏</text>
    </view>
    <view class="me-tab {{tab === 'wrong' ? 'active' : ''}}" data-tab="wrong" bindtap="switchTab">
      <text>❌ 错题</text>
    </view>
  </view>

  <view class="container">
    <view class="me-list">
      <view class="me-card" wx:for="{{tab === 'favorite' ? favorites : wrongs}}" wx:key="id"
            data-id="{{item.id}}" data-paperId="{{item.paper_id}}" bindtap="goToQuestion">
        <view class="me-head">
          <text class="me-no">{{item.question_no}}</text>
          <text class="me-type">{{item.question_type}}</text>
        </view>
        <text class="me-stem">{{item.stem_preview}}</text>
        <text class="me-paper">📄 {{item.paper_title}}</text>
      </view>
      <view class="empty-state" wx:if="{{tab === 'favorite' && favorites.length === 0}}">
        <text class="empty-icon">⭐</text>
        <text>还没有收藏，去逛逛吧</text>
        <view class="empty-btn" bindtap="goToPapers">去发现</view>
      </view>
      <view class="empty-state" wx:if="{{tab === 'wrong' && wrongs.length === 0}}">
        <text class="empty-icon">🎉</text>
        <text>还没有错题记录，继续加油</text>
        <view class="empty-btn" bindtap="goToSearch">开始做题</view>
      </view>
    </view>
  </view>
</view>