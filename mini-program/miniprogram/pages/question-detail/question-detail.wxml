<view class="page">
  <view class="q-header card" wx:if="{{question}}">
    <view class="q-meta-row">
      <text class="q-no">{{question.question_no}}</text>
      <text class="q-type">{{question.question_type}}</text>
      <text class="q-score">{{question.score}}分</text>
      <text class="q-paper" bindtap="goToPaper">📄 查看试卷</text>
    </view>
  </view>

  <view class="container">
    <view class="stem-section card">
      <view class="section-head">
        <text class="section-title">题目</text>
        <text class="copy-btn" bindtap="copyStem">复制</text>
      </view>
      <rich-text nodes="{{question ? question.stem_nodes : []}}" class="stem-content" />
    </view>

    <view class="action-row">
      <view class="action-btn {{favorite ? 'active' : ''}}" bindtap="toggleFavorite">
        <text class="btn-icon">{{favorite ? '⭐' : '☆'}}</text>
        <text>收藏</text>
      </view>
      <view class="action-btn {{wrong ? 'active' : ''}}" bindtap="toggleWrong">
        <text class="btn-icon">{{wrong ? '❌' : '➕'}}</text>
        <text>错题</text>
      </view>
      <view class="action-btn" bindtap="toggleAnswer">
        <text class="btn-icon">👁</text>
        <text>{{showAnswer ? '隐藏' : '查看'}}答案</text>
      </view>
    </view>

    <view class="answer-section card" wx:if="{{showAnswer && question}}">
      <text class="section-title">答案</text>
      <rich-text nodes="{{question.answer_nodes}}" class="answer-content" />
    </view>

    <view class="action-row" wx:if="{{question}}">
      <view class="action-btn" bindtap="toggleSolution">
        <text class="btn-icon">📖</text>
        <text>{{showSolution ? '隐藏' : '查看'}}解析</text>
      </view>
    </view>

    <view class="solution-section card" wx:if="{{showSolution && question}}">
      <text class="section-title">解析</text>
      <rich-text nodes="{{question.solution_nodes}}" class="solution-content" />
    </view>
  </view>
</view>