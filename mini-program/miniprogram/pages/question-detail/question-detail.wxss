.page { background: #F5F5F5; min-height: 100vh; }
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.q-header { margin: 0 20rpx 16rpx; border-radius: 12rpx 12rpx 0 0; }
.q-meta-row { display: flex; align-items: center; gap: 12rpx; }
.q-no { font-size: 30rpx; font-weight: 700; color: #07C160; }
.q-type { font-size: 20rpx; background: #FFF7E6; color: #FA8C16; padding: 2rpx 12rpx; border-radius: 8rpx; }
.q-score { font-size: 22rpx; color: #999; }
.q-paper { font-size: 22rpx; color: #1677FF; margin-left: auto; }
.container { padding: 0 20rpx 24rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; padding-bottom: 10rpx; border-bottom: 1rpx solid #eee; }
.section-title { font-size: 28rpx; font-weight: 600; color: #333; }
.copy-btn { font-size: 22rpx; color: #1677FF; }
.stem-content { font-size: 26rpx; line-height: 1.8; color: #333; }
.action-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.action-btn { flex: 1; background: #fff; border-radius: 40rpx; padding: 16rpx 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.04); }
.action-btn.active { background: #FFF7E6; }
.btn-icon { font-size: 28rpx; }
.action-btn text:last-child { font-size: 20rpx; color: #666; }
.answer-content { font-size: 24rpx; line-height: 1.8; color: #07C160; }
.solution-content { font-size: 24rpx; line-height: 1.8; color: #555; }