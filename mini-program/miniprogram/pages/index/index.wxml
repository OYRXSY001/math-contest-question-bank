<view class="page">
  <view class="page-header">
    <view class="header-title">全国大学生数学竞赛真题库</view>
    <view class="header-sub">非数学A类 · 历届真题 · 公式解析</view>
    <view class="search-bar" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索题目、知识点、年份…</text>
    </view>
  </view>

  <view class="container">
    <view class="stats-row">
      <view class="stat-item" bindtap="goToPapers">
        <text class="stat-num">{{stats.papers}}</text>
        <text class="stat-label">套真题</text>
      </view>
      <view class="stat-item" bindtap="goToPapers">
        <text class="stat-num">{{stats.questions}}</text>
        <text class="stat-label">道题目</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.knowledgePoints}}</text>
        <text class="stat-label">个知识点</text>
      </view>
    </view>

    <view class="section-title">最新真题</view>
    <view class="paper-list">
      <view class="paper-card" wx:for="{{latestPapers}}" wx:key="id" data-id="{{item.id}}" bindtap="goToPaper">
        <view class="paper-head">
          <text class="paper-year">{{item.year}}</text>
          <text class="paper-type">{{item.round}}</text>
        </view>
        <text class="paper-title">{{item.title}}</text>
        <view class="paper-meta">
          <text class="meta-item">📝 {{item.question_count}}题</text>
          <text class="meta-item">⏱ {{item.total_score}}分</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{latestPapers.length === 0}}">
        <text class="empty-icon">📚</text>
        <text>暂无数据</text>
      </view>
    </view>

    <view class="quick-actions">
      <view class="action-btn" bindtap="goToPapers">
        <text class="action-icon">📖</text>
        <text>全部真题</text>
      </view>
      <view class="action-btn" bindtap="goSearch">
        <text class="action-icon">🔍</text>
        <text>搜索题目</text>
      </view>
      <view class="action-btn" bindtap="goToMe">
        <text class="action-icon">⭐</text>
        <text>我的收藏</text>
      </view>
    </view>
  </view>
</view>