.page { background: #F5F5F5; min-height: 100vh; }
.page-header { background: linear-gradient(135deg, #07C160, #06AE56); color: #fff; padding: 48rpx 32rpx 40rpx; }
.header-title { font-size: 38rpx; font-weight: 700; }
.header-sub { font-size: 24rpx; opacity: .8; margin-top: 6rpx; }
.search-bar { display: flex; align-items: center; background: rgba(255,255,255,.2); border-radius: 40rpx; padding: 12rpx 24rpx; margin-top: 24rpx; }
.search-icon { font-size: 28rpx; }
.search-placeholder { font-size: 26rpx; opacity: .7; margin-left: 12rpx; }
.container { padding: 24rpx; }
.stats-row { display: flex; justify-content: space-around; background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06); }
.stat-item { text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #07C160; display: block; }
.stat-label { font-size: 22rpx; color: #999; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; color: #333; }
.paper-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.paper-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.paper-year { font-size: 28rpx; font-weight: 600; color: #1677FF; }
.paper-type { font-size: 20rpx; background: #E8F8E8; color: #07C160; padding: 2rpx 12rpx; border-radius: 10rpx; }
.paper-title { font-size: 26rpx; color: #333; }
.paper-meta { margin-top: 10rpx; display: flex; gap: 24rpx; }
.meta-item { font-size: 22rpx; color: #999; }
.empty-state { text-align: center; padding: 60rpx 0; color: #999; }
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.quick-actions { display: flex; justify-content: space-around; margin-top: 24rpx; }
.action-btn { flex: 1; background: #fff; border-radius: 12rpx; padding: 24rpx 0; margin: 0 8rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.action-icon { font-size: 36rpx; display: block; margin-bottom: 8rpx; }